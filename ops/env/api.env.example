# TestBoard API - PRODUCTION settings template (ADR 0010).
#
# `ops/testboard.sh setup` copies this to  /home/testboard/testboard-data/config/api.env  (permission 600),
# OUTSIDE the public web folder. Fill in the database account there with:  nano /home/testboard/testboard-data/config/api.env
# Never put the real file in Git, in public/testboard, or in a chat message.

NODE_ENV=production
# Loopback only: Apache forwards /testboard/api/ here. Keep the port 8787 (it is in .htaccess).
API_HOST=127.0.0.1
API_PORT=8787
LOG_REQUESTS=false

# Public address of the site (scheme + host, no path). Mutating requests from any other
# origin are refused (CSRF defence). setup.sh fills it from the PUBLIC_URL you enter.
ALLOWED_ORIGINS=__PUBLIC_ORIGIN__

# Database on the SAME server (TCP 127.0.0.1, never the public IP). Use the limited
# service account (SELECT/INSERT/UPDATE/DELETE on testboard.*), not an admin account.
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=testboard
DB_USER=__DB_USER__
DB_PASSWORD=__DB_PASSWORD__
DB_POOL_SIZE=10

# Login sessions.
SESSION_HOURS=12
SESSION_IDLE_MINUTES=120

# Private evidence storage, outside the web root (setup.sh fills the absolute path).
STORAGE_DIR=__STORAGE_DIR__
# basic = built-in checks, nothing to install. clamav only if a ClamAV daemon runs.
SCAN_ENGINE=basic

# Retention (owner decision 2026-11-20): unused uploads and import work files after 90 days.
RETENTION_UNUSED_FILE_DAYS=90
RETENTION_IMPORT_DAYS=90
