#!/usr/bin/env bash
# Replacement for the server's own update.sh (ADR 0010, docs/deploy/vps-deploy.md).
#
# On the VPS, once:   cp ops/update.sh.example update.sh && chmod +x update.sh
# From then on:       ./update.sh            (latest main)
#                     ./update.sh v1.0.0     (a specific release tag)
#
# It no longer only pulls files: it backs up, builds, asks before database migrations,
# restarts the API, rolls back automatically when the new version is unhealthy, and runs
# the public safety checks.
set -euo pipefail
cd "$(dirname "$0")"
exec bash ops/testboard.sh deploy "$@"
