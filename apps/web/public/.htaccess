# Copied into apps/web/dist by Vite. Second pass of the rules in the repository root
# .htaccess: serve real build files, otherwise the single-page app (deep links, TB-OPS-001).

Options -Indexes -MultiViews
DirectoryIndex index.html

<IfModule mod_rewrite.c>
  RewriteEngine On

  # Real file of the build (index.html, assets/*, brand/*, templates/*).
  RewriteCond %{REQUEST_FILENAME} -f
  RewriteRule ^ - [L]

  # Something that looks like a file but is not in the build: plain 404.
  RewriteRule \.[A-Za-z0-9]{1,8}$ - [R=404,L]

  # App routes such as /testboard/projects/KARIR/runs/12 -> the app shell.
  RewriteRule ^ index.html [L]
</IfModule>

<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set X-Frame-Options "DENY"
  # Hashed assets never change: cache for a year. The shell must always be revalidated
  # so a deploy is picked up immediately.
  <FilesMatch "\.(js|css|woff2|svg|png|webp|ico)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  <FilesMatch "^index\.html$">
    Header set Cache-Control "no-cache"
    Header always set Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self'; connect-src 'self'; frame-ancestors 'none'; base-uri 'self'; form-action 'self'; object-src 'none'"
  </FilesMatch>
</IfModule>
