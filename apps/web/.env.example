# PUBLIC frontend config only. Every VITE_* value is embedded in the browser bundle:
# NEVER put passwords, DB credentials, tokens or private keys here.
# Copy to apps/web/.env.local for local overrides.
VITE_APP_NAME=TestBoard PASKER ID
# Same-origin path; the Vite dev server proxies /api to the local API.
VITE_API_BASE_URL=/api/v1
# true = mock data only (Cloudflare demo / no backend). false = call the real API.
VITE_DEMO_MODE=true
VITE_DEFAULT_LOCALE=id
VITE_BASE_PATH=/

# Dev-server only (not exposed to the browser): where /api is proxied to.
API_PROXY_TARGET=http://127.0.0.1:8787
