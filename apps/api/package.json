{
  "name": "@testboard/api",
  "version": "0.11.3",
  "private": true,
  "description": "TestBoard PASKER ID backend API (Hono + Node.js)",
  "type": "module",
  "scripts": {
    "dev": "tsx watch --conditions=source src/index.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "admin:create-super": "tsx --conditions=source scripts/create-super-admin.ts",
    "db:seed": "tsx --conditions=source scripts/seed-dev.ts",
    "maintenance": "node dist/maintenance/cli.js",
    "admin:protect": "tsx --conditions=source scripts/protect-super-admin.ts"
  },
  "dependencies": {
    "@hono/node-server": "^2.1.9",
    "@node-rs/argon2": "~2.2.2",
    "@testboard/shared": "*",
    "busboy": "^1.6.0",
    "fast-xml-parser": "^5.12.1",
    "hono": "^4.13.19",
    "mysql2": "~3.24.6",
    "sharp": "^0.35.5",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/busboy": "^1.5.5",
    "@types/node": "^24.19.2",
    "tsx": "^4.23.15",
    "vitest": "^5.1.1"
  }
}
