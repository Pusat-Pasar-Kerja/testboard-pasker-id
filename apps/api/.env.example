# PRIVATE backend env. Copy to apps/api/.env for local development.
# Never commit the real .env and never put these values in VITE_* variables.
NODE_ENV=development
API_HOST=127.0.0.1
API_PORT=8787
LOG_REQUESTS=true

# --- Milestone 3+ (local database). 127.0.0.1 here means YOUR laptop, never the VPS. ---
# DB_HOST=127.0.0.1
# DB_PORT=3307
# DB_NAME=testboard
# DB_USER=testboard_dev
# DB_PASSWORD=CHANGE_ME_FOR_LOCAL_ONLY

# --- Milestone 2+ (sessions) ---
# SESSION_SECRET=GENERATE_RANDOM_AT_LEAST_32_BYTES

# --- Milestone 5+ evidence (ADR 0008) ---
# Private storage OUTSIDE any web root. Default in development: <repo>/.private-storage.
# Required in production, must be absolute and outside the application folder:
# STORAGE_DIR=/var/lib/testboard/storage
# basic = built-in content checks (default, nothing to install); clamav = ClamAV daemon.
# SCAN_ENGINE=basic
# CLAMD_HOST=127.0.0.1
# CLAMD_PORT=3310
