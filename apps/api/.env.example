# PRIVATE backend env. Copy to apps/api/.env for local development.
# Never commit the real .env and never put these values in VITE_* variables.
NODE_ENV=development
API_HOST=127.0.0.1
API_PORT=8787
LOG_REQUESTS=true

# --- Milestone 3+ (local database). 127.0.0.1 here means YOUR laptop, never the VPS. ---
# DB_HOST=127.0.0.1
# DB_PORT=3307
# DB_NAME=testboard
# DB_USER=testboard_dev
# DB_PASSWORD=CHANGE_ME_FOR_LOCAL_ONLY

# --- Milestone 2+ (sessions) ---
# SESSION_SECRET=GENERATE_RANDOM_AT_LEAST_32_BYTES

# --- Milestone 5+ (private evidence storage, outside any web root) ---
# FILE_STORAGE_ROOT=./.private-storage
# FILE_PROCESSOR_MODE=development
