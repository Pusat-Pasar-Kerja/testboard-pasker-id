{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "TestBoard AI Test Cases Import v1.0",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "schema_version",
    "project_code",
    "source_kind",
    "source_locale",
    "cases"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "1.0"
    },
    "project_code": {
      "type": "string",
      "minLength": 1
    },
    "source_kind": {
      "type": "string",
      "enum": [
        "AI",
        "LEGACY",
        "MANUAL"
      ]
    },
    "source_locale": {
      "type": "string",
      "enum": [
        "id",
        "en"
      ]
    },
    "suite_name": {
      "type": "string"
    },
    "cases": {
      "type": "array",
      "minItems": 1,
      "maxItems": 5000,
      "items": {
        "$ref": "#/$defs/testCase"
      }
    }
  },
  "$defs": {
    "testCase": {
      "type": "object",
      "additionalProperties": true,
      "required": [
        "module_code",
        "title",
        "expected_result"
      ],
      "properties": {
        "case_code": {
          "type": "string",
          "maxLength": 100
        },
        "module_code": {
          "type": "string",
          "minLength": 1,
          "maxLength": 40
        },
        "suite_name": {
          "type": "string",
          "maxLength": 255
        },
        "category": {
          "type": "string"
        },
        "title": {
          "type": "string",
          "minLength": 3
        },
        "requirement_refs": {
          "type": "string"
        },
        "priority_code": {
          "type": "string",
          "enum": [
            "MUST_HAVE",
            "SHOULD_HAVE",
            "COULD_HAVE",
            "WONT_HAVE"
          ]
        },
        "test_type_code": {
          "type": "string",
          "enum": [
            "POSITIVE",
            "NEGATIVE",
            "RBAC",
            "SLA",
            "UI_UX",
            "INTEGRATION",
            "OTHER"
          ]
        },
        "actor_label": {
          "type": "string"
        },
        "preconditions": {
          "type": "string"
        },
        "test_steps_text": {
          "type": "string"
        },
        "expected_result": {
          "type": "string",
          "minLength": 1
        },
        "source_locale": {
          "type": "string",
          "enum": [
            "id",
            "en"
          ]
        },
        "source_document": {
          "type": "string"
        }
      }
    }
  }
}
